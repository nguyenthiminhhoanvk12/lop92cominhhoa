rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() && (
        request.auth.token.email == 'nguyenthiminhhoanvk12@gmail.com'
      );
    }

    // Test connection endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users Collection - Allow read & write for app account management and authentication
    match /users/{userId} {
      allow read, write: if true;
    }

    // Classes Collection - Homeroom classes
    match /classes/{classId} {
      allow read, write: if true;
    }

    // Students Collection
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Parents Collection
    match /parents/{parentId} {
      allow read, write: if true;
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // Scores Collection
    match /scores/{scoreId} {
      allow read, write: if true;
    }

    // Competition Rules
    match /competitionRules/{ruleId} {
      allow read, write: if true;
    }

    // Competitions Collection
    match /competitions/{competitionId} {
      allow read, write: if true;
    }

    // Daily Reports Collection
    match /dailyReports/{reportId} {
      allow read, write: if true;
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      allow read, write: if true;
    }

    // Messages Collection
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
